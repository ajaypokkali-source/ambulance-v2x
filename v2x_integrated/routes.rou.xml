<?xml version="1.0" encoding="UTF-8"?>

<routes>

    <!--
        routes_v2x.rou.xml

        This is the v2v_stress_test baseline routes.rou.xml, UNCHANGED
        in every existing vehicle/flow, plus additions needed for the
        integrated V2X test:

          - blocker_3 : a second overtake further down the corridor,
                        past J2, so the lane-change maneuver repeats
                        after the ambulance has already been through
                        one signal-preemption cycle.

          - a couple of extra side-road vehicles timed to arrive at
            J3 / J4 while the ambulance is near, so the intersection
            V2V-yield logic and the multi-TLS V2I preemption both have
            something to demonstrate at those junctions too.

        Nothing below removes or shortens any of the original traffic.
    -->

    <vType
        id="car"
        vClass="passenger"
        accel="2.6"
        decel="4.5"
        sigma="0.2"
        length="5"
        minGap="2.5"
        maxSpeed="13.89"
        lcStrategic="1.0"
        lcCooperative="1.0"
        lcSpeedGain="1.0"
        lcKeepRight="0.0"
    />

    <vType
        id="ambulance"
        vClass="emergency"
        accel="3.5"
        decel="5.0"
        sigma="0.1"
        length="6"
        minGap="2.0"
        maxSpeed="16.67"
        color="1,0,0"
        lcStrategic="0.0"
        lcCooperative="1.0"
        lcSpeedGain="0.0"
        lcKeepRight="0.0"
    />

    <!--
        blocker_car: same as "car" except its maxSpeed is capped well
        below the ambulance's real-world average pace.

        WHY THIS EXISTS: blocker_1/2/3 used to be plain type="car"
        with departSpeed="8" - but departSpeed only sets the INITIAL
        speed. With nothing capping them afterward, they freely
        accelerate up toward "car"'s 13.89 m/s maxSpeed on open road,
        which is close enough to the ambulance's real average pace
        (after signal waits) that the closing rate becomes small and
        timing-sensitive. That's why blocker_2 took 21s longer to get
        caught between two otherwise-identical runs, and why blocker_3
        (60m further ahead) was never caught at all in one run. Capping
        blockers at 9 m/s keeps a solid, reliable closing margin against
        the ambulance regardless of exact signal timing.
    -->
    <vType
        id="blocker_car"
        vClass="passenger"
        accel="2.6"
        decel="4.5"
        sigma="0.2"
        length="5"
        minGap="2.5"
        maxSpeed="9.0"
        lcStrategic="1.0"
        lcCooperative="1.0"
        lcSpeedGain="1.0"
        lcKeepRight="0.0"
    />


    <!-- MAIN CORRIDOR -->

    <route
        id="main_forward"
        edges="J1_J2 J2_J3 J3_J4 J4_J5"
    />

    <route
        id="main_reverse"
        edges="J5_J4 J4_J3 J3_J2 J2_J1"
    />


    <!-- SIDE ROADS -->

    <route
        id="J1N_to_main"
        edges="J1N_J1 J1_J2 J2_J3 J3_J4 J4_J5"
    />

    <route
        id="J1S_to_main"
        edges="J1S_J1 J1_J2 J2_J3 J3_J4 J4_J5"
    />

    <route
        id="J2N_to_main"
        edges="J2N_J2 J2_J3 J3_J4 J4_J5"
    />

    <route
        id="J2S_to_main"
        edges="J2S_J2 J2_J3 J3_J4 J4_J5"
    />

    <route
        id="J3N_to_main"
        edges="J3N_J3 J3_J4 J4_J5"
    />

    <route
        id="J3S_to_main"
        edges="J3S_J3 J3_J4 J4_J5"
    />

    <route
        id="J4N_to_main"
        edges="J4N_J4 J4_J5"
    />

    <route
        id="J4S_to_main"
        edges="J4S_J4 J4_J5"
    />


    <!-- ================================================== -->
    <!-- AMBULANCE -->
    <!-- ================================================== -->

    <vehicle
        id="ambulance"
        type="ambulance"
        route="main_forward"
        depart="20"
        departLane="0"
        departPos="20"
        departSpeed="max"
    />


    <!-- ================================================== -->
    <!-- PRIMARY VEHICLE DIRECTLY AHEAD (baseline, unchanged) -->
    <!-- ================================================== -->

    <!--
        This is the proven baseline vehicle.

        It starts in the SAME lane as the ambulance.

        Ambulance:
            position = 20 m

        blocker_1:
            position = 115 m

        Initial separation:
            approximately 95 m
    -->

    <vehicle
        id="blocker_1"
        type="blocker_car"
        route="main_forward"
        depart="20"
        departLane="0"
        departPos="115"
        departSpeed="8"
    />


    <!-- ================================================== -->
    <!-- SECOND VEHICLE AHEAD (baseline, unchanged) -->
    <!-- ================================================== -->

    <vehicle
        id="blocker_2"
        type="blocker_car"
        route="main_forward"
        depart="20"
        departLane="0"
        departPos="175"
        departSpeed="8"
    />


    <!-- ================================================== -->
    <!-- THIRD VEHICLE, FURTHER DOWN J1_J2                   -->
    <!-- NEW: a third same-lane blocker so the maneuver      -->
    <!-- repeats a second time, carrying into J2_J3 (past    -->
    <!-- the J2 signal) since it enters the corridor slowly  -->
    <!-- and is caught up with there.                        -->
    <!--                                                      -->
    <!-- Departs on the SAME edge as the ambulance (like      -->
    <!-- blocker_1 / blocker_2) so its distance to the        -->
    <!-- ambulance is unambiguous from the moment it departs. -->
    <!-- ================================================== -->

    <vehicle
        id="blocker_3"
        type="blocker_car"
        route="main_forward"
        depart="20"
        departLane="0"
        departPos="235"
        departSpeed="8"
    />


    <!-- ================================================== -->
    <!-- ADJACENT-LANE TRAFFIC (baseline, unchanged) -->
    <!-- ================================================== -->

    <vehicle
        id="lane1_car_1"
        type="car"
        route="main_forward"
        depart="20"
        departLane="1"
        departPos="55"
        departSpeed="10"
    />

