<?xml version="1.0" encoding="UTF-8"?>

<routes>

    <!--
        routes.rou.xml  (v2x_relay)

        Identical to v2x_integrated's routes.rou.xml (same baseline
        traffic: blocker_1/2/3, lane1_car_1/2/3, car0-6, reverse0-4,
        side-road arrivals and flows) PLUS two new vehicles:

            relay_1, relay_2

        These exist ONLY for this scenario. They are ordinary "car"
        vehicles placed in lane 1 (so they never trigger the same-lane
        V2V overtake logic - they are not obstacles, they are relay
        nodes), spaced so that:

            ambulance <-(~65m)-> relay_1 <-(~80m)-> relay_2 <-(~140m)-> J2

        With V2V_RELAY_RANGE = 100m (see v2x_relay_test.py), relay_1 is
        always reachable directly from the ambulance, and relay_2 is
        reachable from relay_1 - so a genuine 2-hop store-and-forward
        path (ambulance -> relay_1 -> relay_2 -> J2) becomes available
        well before the ambulance itself is within direct V2I range of
        J2 (V2I_DIRECT_RANGE = 70m). This is what the relay module is
        there to demonstrate; see v2x_relay_test.py for the mechanism.

        relay_1/relay_2 stay on main_forward (the full corridor), so
        they can keep acting as opportunistic relays for J3/J4 too if
        they stay near the ambulance - that part is NOT guaranteed the
        way the J2 chain is, since gaps drift over a 900m corridor with
        signals in between. J3/J4 relay coverage instead falls back on
        whatever organic side-road/flow traffic happens to be nearby
        (J3N_1, J4S_1, forward_flow from t=60 onward) - check the
        console [RELAY] log after a real run to see what actually
        happened, and retune relay_1/relay_2's departPos/speed here if
        you want a guaranteed chain further down the corridor too.
    -->

    <vType
        id="car"
        vClass="passenger"
        accel="2.6"
        decel="4.5"
        sigma="0.2"
        length="5"
        minGap="2.5"
        maxSpeed="13.89"
        lcStrategic="1.0"
        lcCooperative="1.0"
        lcSpeedGain="1.0"
        lcKeepRight="0.0"
    />

    <vType
        id="ambulance"
        vClass="emergency"
        accel="3.5"
        decel="5.0"
        sigma="0.1"
        length="6"
        minGap="2.0"
        maxSpeed="16.67"
        color="1,0,0"
        lcStrategic="0.0"
        lcCooperative="1.0"
        lcSpeedGain="0.0"
        lcKeepRight="0.0"
    />

    <vType
        id="blocker_car"
        vClass="passenger"
        accel="2.6"
        decel="4.5"
        sigma="0.2"
        length="5"
        minGap="2.5"
        maxSpeed="9.0"
        lcStrategic="1.0"
        lcCooperative="1.0"
        lcSpeedGain="1.0"
        lcKeepRight="0.0"
    />


    <!-- MAIN CORRIDOR -->

    <route
        id="main_forward"
        edges="J1_J2 J2_J3 J3_J4 J4_J5"
    />

    <route
        id="main_reverse"
        edges="J5_J4 J4_J3 J3_J2 J2_J1"
    />


    <!-- SIDE ROADS -->

    <route
        id="J1N_to_main"
        edges="J1N_J1 J1_J2 J2_J3 J3_J4 J4_J5"
    />

    <route
        id="J1S_to_main"
        edges="J1S_J1 J1_J2 J2_J3 J3_J4 J4_J5"
    />

    <route
        id="J2N_to_main"
        edges="J2N_J2 J2_J3 J3_J4 J4_J5"
    />

    <route
        id="J2S_to_main"
        edges="J2S_J2 J2_J3 J3_J4 J4_J5"
    />

    <route
        id="J3N_to_main"
        edges="J3N_J3 J3_J4 J4_J5"
    />

    <route
        id="J3S_to_main"
        edges="J3S_J3 J3_J4 J4_J5"
    />

    <route
        id="J4N_to_main"
        edges="J4N_J4 J4_J5"
    />

    <route
        id="J4S_to_main"
        edges="J4S_J4 J4_J5"
    />


    <!-- ================================================== -->
    <!-- AMBULANCE -->
    <!-- ================================================== -->

    <vehicle
        id="ambulance"
        type="ambulance"
        route="main_forward"
        depart="20"
        departLane="0"
        departPos="20"
        departSpeed="max"
    />


    <!-- ================================================== -->
    <!-- NEW: V2V RELAY CHAIN (lane 1, never triggers the    -->
    <!-- same-lane overtake logic) - see header comment.     -->
    <!-- ================================================== -->

    <vehicle
        id="relay_1"
        type="car"
        route="main_forward"
        depart="20"
        departLane="1"
        departPos="85"
        departSpeed="max"
    />

    <vehicle
        id="relay_2"
        type="car"
        route="main_forward"
        depart="20"
        departLane="1"
        departPos="165"
        departSpeed="max"
    />


    <!-- ================================================== -->
    <!-- PRIMARY VEHICLE DIRECTLY AHEAD (baseline, unchanged) -->
    <!-- ================================================== -->

    <vehicle
        id="blocker_1"
        type="blocker_car"
        route="main_forward"
        depart="20"
        departLane="0"
        departPos="115"
        departSpeed="8"
    />


    <!-- ================================================== -->
    <!-- SECOND VEHICLE AHEAD (baseline, unchanged) -->
    <!-- ================================================== -->

    <vehicle
        id="blocker_2"
        type="blocker_car"
        route="main_forward"
        depart="20"
        departLane="0"
        departPos="175"
        departSpeed="8"
    />


    <!-- ================================================== -->
    <!-- THIRD VEHICLE, FURTHER DOWN J1_J2 (baseline, unchanged) -->
    <!-- ================================================== -->

    <vehicle
        id="blocker_3"
        type="blocker_car"
        route="main_forward"
        depart="20"
        departLane="0"
        departPos="235"
        departSpeed="8"
    />


    <!-- ================================================== -->
    <!-- ADJACENT-LANE TRAFFIC (baseline, unchanged) -->
    <!-- ================================================== -->

    <vehicle
        id="lane1_car_1"
        type="car"
        route="main_forward"
        depart="20"
        departLane="1"
        departPos="55"
        departSpeed="10"
    />

    <vehicle
        id="lane1_car_2"
        type="car"
        route="main_forward"
        depart="20"
        departLane="1"
        departPos="145"
        departSpeed="10"
    />

    <vehicle
        id="lane1_car_3"
        type="car"
        route="main_forward"
        depart="45"
        departLane="1"
        departPos="20"
        departSpeed="10"
    />


    <!-- ================================================== -->
    <!-- NORMAL FORWARD TRAFFIC (baseline, unchanged) -->
    <!-- ================================================== -->

    <vehicle id="car0" type="car" route="main_forward" depart="0"  departLane="1" departSpeed="max"/>
    <vehicle id="car1" type="car" route="main_forward" depart="5"  departLane="0" departSpeed="max"/>
    <vehicle id="car2" type="car" route="main_forward" depart="10" departLane="1" departSpeed="max"/>
    <vehicle id="car3" type="car" route="main_forward" depart="15" departLane="0" departSpeed="max"/>
    <vehicle id="car4" type="car" route="main_forward" depart="25" departLane="1" departSpeed="max"/>
    <vehicle id="car5" type="car" route="main_forward" depart="30" departLane="0" departSpeed="max"/>
    <vehicle id="car6" type="car" route="main_forward" depart="35" departLane="1" departSpeed="max"/>


    <!-- ================================================== -->
    <!-- REVERSE TRAFFIC (baseline, unchanged) -->
    <!-- ================================================== -->

    <vehicle id="reverse0" type="car" route="main_reverse" depart="4"  departLane="0" departSpeed="max"/>
    <vehicle id="reverse1" type="car" route="main_reverse" depart="11" departLane="1" departSpeed="max"/>
    <vehicle id="reverse2" type="car" route="main_reverse" depart="18" departLane="0" departSpeed="max"/>
    <vehicle id="reverse3" type="car" route="main_reverse" depart="25" departLane="1" departSpeed="max"/>
    <vehicle id="reverse4" type="car" route="main_reverse" depart="32" departLane="0" departSpeed="max"/>


    <!-- ================================================== -->
    <!-- SIDE ROAD TRAFFIC (baseline, unchanged) -->
    <!-- ================================================== -->

    <vehicle id="J1N_0" type="car" route="J1N_to_main" depart="8"  departSpeed="max"/>
    <vehicle id="J1S_0" type="car" route="J1S_to_main" depart="14" departSpeed="max"/>
    <vehicle id="J2N_0" type="car" route="J2N_to_main" depart="20" departSpeed="max"/>
    <vehicle id="J2S_0" type="car" route="J2S_to_main" depart="26" departSpeed="max"/>
    <vehicle id="J3N_0" type="car" route="J3N_to_main" depart="32" departSpeed="max"/>
    <vehicle id="J3S_0" type="car" route="J3S_to_main" depart="38" departSpeed="max"/>
    <vehicle id="J4N_0" type="car" route="J4N_to_main" depart="42" departSpeed="max"/>
    <vehicle id="J4S_0" type="car" route="J4S_to_main" depart="48" departSpeed="max"/>


    <!-- ================================================== -->
    <!-- EXTRA SIDE-ROAD ARRIVALS NEAR J3 / J4 (baseline,    -->
    <!-- unchanged) - these also double as opportunistic     -->
    <!-- V2V relay nodes for J3/J4 in this scenario.         -->
    <!-- ================================================== -->

    <vehicle id="J3N_1" type="car" route="J3N_to_main" depart="58" departSpeed="max"/>
    <vehicle id="J4S_1" type="car" route="J4S_to_main" depart="66" departSpeed="max"/>


    <!-- ================================================== -->
    <!-- CONTINUOUS TRAFFIC (baseline, unchanged) -->
    <!-- ================================================== -->

    <flow id="forward_flow" type="car" route="main_forward" begin="60" end="300" period="5"  departLane="random" departSpeed="max"/>
    <flow id="reverse_flow" type="car" route="main_reverse" begin="60" end="300" period="7"  departLane="random" departSpeed="max"/>
    <flow id="J1N_flow" type="car" route="J1N_to_main" begin="60" end="300" period="15" departLane="random" departSpeed="max"/>
    <flow id="J1S_flow" type="car" route="J1S_to_main" begin="65" end="300" period="17" departLane="random" departSpeed="max"/>
    <flow id="J2N_flow" type="car" route="J2N_to_main" begin="70" end="300" period="13" departLane="random" departSpeed="max"/>
    <flow id="J2S_flow" type="car" route="J2S_to_main" begin="75" end="300" period="16" departLane="random" departSpeed="max"/>
    <flow id="J3N_flow" type="car" route="J3N_to_main" begin="80" end="300" period="14" departLane="random" departSpeed="max"/>
    <flow id="J3S_flow" type="car" route="J3S_to_main" begin="85" end="300" period="18" departLane="random" departSpeed="max"/>
    <flow id="J4N_flow" type="car" route="J4N_to_main" begin="90" end="300" period="15" departLane="random" departSpeed="max"/>
    <flow id="J4S_flow" type="car" route="J4S_to_main" begin="95" end="300" period="20" departLane="random" departSpeed="max"/>

</routes>
