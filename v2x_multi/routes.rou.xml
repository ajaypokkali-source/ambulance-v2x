<routes>

    <!--
        routes.rou.xml  (v2x_multi)

        Bigger corridor, same conventions as v2x_integrated's
        routes.rou.xml: same vTypes (car / ambulance / blocker_car),
        same style of per-junction side routes and flows, just
        generalized from 5 main nodes (J1..J5, 3 signals) to 12 main
        nodes (J1..J12, 10 signals: J2..J11), and from ONE ambulance to
        THREE (ambulance_1, ambulance_2, ambulance_3), each with its
        own dedicated same-lane blocker so the V2V overtake maneuver is
        demonstrated independently for every ambulance, not just the
        first one.

        IMPORTANT (fixed in this revision): every <vehicle> and <flow>
        below is emitted in a SINGLE block sorted by depart/begin time.
        SUMO's route loader requires elements to appear in non-decreasing
        departure order - earlier versions of this generator wrote
        vehicles in topic groups (ambulances, then blockers, then lane1
        cars, then background cars/reverses, then flows), which put
        later-departing vehicles (e.g. ambulance_1 at t=20) BEFORE
        earlier-departing ones still to come later in the file (car1 at
        t=5, car2 at t=10, car3 at t=15, and - crucially - the
        forward_flow/reverse_flow/side flows beginning at t=60, which
        landed after ambulance_2 at t=70 only by luck and before other
        later one-off vehicles). An unsorted route file is exactly the
        kind of defect that can cause some vehicles to silently never
        be inserted by SUMO rather than erroring - which matched the
        observed symptom (blocker_1 and blocker_2 never appearing)
        closely enough that it's fixed here regardless of whether it
        turns out to be the full explanation.
    -->

    <vType
        id="car"
        vClass="passenger"
        accel="2.6"
        decel="4.5"
        sigma="0.2"
        length="5"
        minGap="2.5"
        maxSpeed="13.89"
        lcStrategic="1.0"
        lcCooperative="1.0"
        lcSpeedGain="1.0"
        lcKeepRight="0.0"
    />

    <vType
        id="ambulance"
        vClass="emergency"
        accel="3.5"
        decel="5.0"
        sigma="0.1"
        length="6"
        minGap="2.0"
        maxSpeed="16.67"
        color="1,0,0"
        lcStrategic="0.0"
        lcCooperative="1.0"
        lcSpeedGain="0.0"
        lcKeepRight="0.0"
    />

    <!--
        blocker_car: same as v2x_integrated - maxSpeed capped well below
        the ambulance's real-world average pace, so every blocker has a
        reliable, timing-independent closing margin against whichever
        ambulance is catching up to it (see the long comment in
        v2x_integrated/routes.rou.xml for the full story on why this
        matters - departSpeed alone is not enough).
    -->
    <vType
        id="blocker_car"
        vClass="passenger"
        accel="2.6"
        decel="4.5"
        sigma="0.2"
        length="5"
        minGap="2.5"
        maxSpeed="9.0"
        lcStrategic="1.0"
        lcCooperative="1.0"
        lcSpeedGain="1.0"
        lcKeepRight="0.0"
    />


    <!-- MAIN CORRIDOR -->

    <route
        id="main_forward"
        edges="J1_J2 J2_J3 J3_J4 J4_J5 J5_J6 J6_J7 J7_J8 J8_J9 J9_J10 J10_J11 J11_J12"
    />

    <route
        id="main_reverse"
        edges="J12_J11 J11_J10 J10_J9 J9_J8 J8_J7 J7_J6 J6_J5 J5_J4 J4_J3 J3_J2 J2_J1"
    />


    <!-- SIDE ROADS (every junction EXCEPT the terminal J12,
         exactly mirroring v2x_integrated's omission of J5-side
         routes - a side road at the very last node would have
