    <!-- ================================================== -->
    <!-- AMBULANCES (3, staggered departures), their        -->
    <!-- dedicated blockers, adjacent-lane traffic, general -->
    <!-- background traffic, and continuous flows - ALL     -->
    <!-- merged below in one depart/begin-time-sorted block -->
    <!-- (see the long comment at the top of this file).    -->
    <!--                                                      -->
    <!-- Spacing rationale: ambulance_1 and ambulance_2 are   -->
    <!-- only 50s apart (well clear of each other physically  -->
    <!-- at cruise speed - about 800m - so they never collide -->
    <!-- or contend for the same lane), but close enough that -->
    <!-- while ambulance_1 is still working its way through   -->
    <!-- the back half of the corridor, ambulance_2 is        -->
    <!-- already active at the front half - so the controller -->
    <!-- genuinely has TWO independent emergency corridors     -->
    <!-- open across different junctions at the same time.    -->
    <!-- ambulance_3 departs much later (190s) so it gets a    -->
    <!-- clean run once the first two have mostly cleared,     -->
    <!-- demonstrating the system also works back-to-back, not -->
    <!-- just concurrently.                                    -->
    <!-- ================================================== -->

    <vehicle id="car0" type="car" route="main_forward" depart="0" departLane="1" departSpeed="max"/>

    <vehicle id="reverse0" type="car" route="main_reverse" depart="4" departLane="0" departSpeed="max"/>

